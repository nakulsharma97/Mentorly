# Build directories
/backend/target/
/frontend/dist/
/frontend/node_modules/
/frontend/coverage/
/frontend/playwright-report/
/frontend/playwright-report-a11y/
/frontend/test-results/
/backups/
# Runtime uploads (user files land under uploads/chat on the server)
/backend/uploads/
/contracts/artifacts/
/contracts/cache/
/contracts/coverage/

# Root-level artifacts
node_modules/
*.log
login.json
login2.json
login*.json
backend_logs*.txt

# Freebuff desktop app runtime state (never commit)
.freebuff/

# Playwright e2e screenshots (generated artifacts)
frontend/e2e-screenshots/

# Windows reserved device names / accidental artifacts
nul
out.txt
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lock files
yarn.lock
pnpm-lock.yaml

# Environment
.env
.env.*
.env.local
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.iml

# Backup / broken files (not to be committed)
*.broken
*.bak
*.orig

# Database backup dumps (never commit full DB exports)
backend/scripts/backup-*.sql
backend/scripts/*-tmp.sql

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# System and user-specific
# Windows env-var paths (e.g. %AppData%/) can leak into the repo if a global
# npm install (`npm install -g`) is ever run from this directory — the entire
# global npm folder (node_modules, .cmd shims, binaries) gets committed. Never
# track these; if a stray %AppData%/ (or similar) folder reappears, delete it.
%AppData%/
%LOCALAPPDATA%/
Downloads/

# Dependencies
/backend/.classpath
/backend/.project
/backend/.settings/

# Maven / Java
/target/
*.jar
*.war

# Node
.npm

# Python
__pycache__/
*.py[cod]
*$py.class
