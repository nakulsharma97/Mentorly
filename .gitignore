# Build directories
/backend/target/
/frontend/dist/
/frontend/node_modules/
/frontend/coverage/
/frontend/playwright-report/
/frontend/playwright-report-a11y/
/frontend/test-results/
/backups/

# Root-level artifacts
node_modules/
*.log

# Windows reserved device names / accidental artifacts
nul
out.txt
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Lock files
yarn.lock
pnpm-lock.yaml

# Environment
.env
.env.*
.env.local
!.env.example

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.iml

# Backup / broken files (not to be committed)
*.broken
*.bak
*.orig

# OS files
.DS_Store

# System and user-specific
%AppData%/
Downloads/

# Dependencies
/backend/.classpath
/backend/.project
/backend/.settings/

# Maven / Java
/target/
*.jar
*.war

# Node
.npm

# Python
__pycache__/
*.py[cod]
*$py.class
