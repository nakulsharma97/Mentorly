# ═══════════════════════════════════════════════════════════════
#  Mentorly Platform - Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
#
#  Instructions:
#    1. Copy this file to .env (gitignored - never commit secrets)
#    2. Replace ALL placeholder values (replace-me, your-*)
#    3. For production, generate strong secrets using:
#         bash scripts/env-setup.sh   (Unix/Mac/Git Bash)
#
#  Required variables will cause the app to FAIL ON STARTUP if missing.

# ═════════════════════════════════════════════
#  REQUIRED - App will not start without these
# ═════════════════════════════════════════════

# JWT signing key - generate with: openssl rand -base64 32
# Minimum 32 characters, must be base64-encoded.
JWT_SECRET=replace-with-a-base64-encoded-32-byte-or-longer-secret

# Database root password for MySQL
MYSQL_ROOT_PASSWORD=replace-with-strong-password

# Database application user password
MYSQL_PASSWORD=replace-with-strong-password

# ═════════════════════════════════════════════
#  RECOMMENDED - Strongly advised for production
# ═════════════════════════════════════════════

# Spring profile - dev, staging, prod
SPRING_PROFILES_ACTIVE=dev

# CORS allowed origins (comma-separated, no trailing slashes)
# For production: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# OAuth2 redirect URL - must match the callback URL in your OAuth app config
# For production: https://yourdomain.com/oauth/callback
OAUTH2_REDIRECT_URL=http://localhost:5174/oauth/callback

# Sentry error tracking DSN (backend) - https://sentry.io
# Leave empty to disable
SENTRY_DSN=

# Sentry error tracking DSN (frontend)
VITE_SENTRY_DSN=

# Frontend API base URL (empty = same origin as frontend)
VITE_API_BASE_URL=

# Frontend environment label (development / staging / production)
VITE_APP_ENV=development

# ═════════════════════════════════════════════
#  OAUTH2 / SSO - Google & GitHub Login
# ═════════════════════════════════════════════
#  Required for social login to work.
#  Falls back to email/password auth if disabled.
#
#  Google: https://console.cloud.google.com/apis/credentials
#    -> Create OAuth 2.0 Client ID (Web application)
#    -> Authorized redirect URIs: http://localhost:5174/login/oauth2/code/google
#    -> For production: https://yourdomain.com/login/oauth2/code/google
#
#  GitHub: https://github.com/settings/developers
#    -> New OAuth App
#    -> Authorization callback URL: http://localhost:5174/login/oauth2/code/github
#    -> For production: https://yourdomain.com/login/oauth2/code/github
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-a-strong-random-google-oauth-client-secret
GITHUB_CLIENT_ID=replace-with-your-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-a-strong-random-github-oauth-client-secret

# ═════════════════════════════════════════════
#  DATABASE - Connection Settings
# ═════════════════════════════════════════════

# Default: local MySQL. In Docker Compose, override to use the mysql service.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/skill?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-a-strong-db-password

# ═════════════════════════════════════════════
#  RATE LIMITING - Tune per environment
# ═════════════════════════════════════════════

APP_RATE_LIMIT_AUTH_PER_MINUTE=20
APP_RATE_LIMIT_PAYMENT_PER_MINUTE=30

# ═════════════════════════════════════════════
#  ADMIN USER - Auto-seeded on first startup
# ═════════════════════════════════════════════
#  Only this user can log in as ADMIN.
#  Signups with role=ADMIN are rejected - this is the only way to create an admin.
#  Set ALL three values to enable auto-seeding.
#
#  SECURITY: In any non-development profile (staging/prod) the backend REFUSES
#  to start when APP_ADMIN_PASSWORD is blank or one of the known defaults
#  (including 'Admin@12345' below). Always set a strong unique password for
#  real environments; the value below is only for local development.
APP_ADMIN_EMAIL=admin@mentorly.app
APP_ADMIN_PASSWORD=Admin@12345
APP_ADMIN_NAME=Platform Admin

# ═════════════════════════════════════════════
#  EMAIL (SMTP) - Optional
# ═════════════════════════════════════════════
#  Email sending (welcome/verification emails) is DISABLED by default
#  (APP_EMAIL_ENABLED=false). Leave it disabled unless you have an SMTP
#  provider, or set it to true together with the credentials below.
#
#  NOTE: The /actuator/health mail probe only runs when email is enabled,
#  so deployments without SMTP still report a green health endpoint.
#  If you enable email, MAIL_PASSWORD is required - a broken SMTP
#  connection will then correctly fail the health check.
APP_EMAIL_ENABLED=false
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=
APP_EMAIL_FROM=no-reply@mentorly.app

# ═════════════════════════════════════════════
#  PAYMENT GATEWAYS
# ═════════════════════════════════════════════
#  At least one payment provider must be configured for payments to work.
#  Use test keys (sk_test_*) for development, live keys (sk_live_*) for production.

# Stripe (REAL test-mode integration) - https://dashboard.stripe.com/apikeys
# 1. Sign in to dashboard.stripe.com and toggle "Test mode" (top-right).
# 2. Developers > API keys -> copy the Secret key (sk_test_...).
# 3. Developers > Webhooks -> copy the signing secret (whsec_...), or run
#    `stripe listen --forward-to localhost:8080/api/v1/payments/webhook/stripe`
#    and use the printed webhook secret. Never use live (sk_live_*) keys here.
STRIPE_SECRET_KEY=replace-with-your-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-test-webhook-secret

# Razorpay - https://dashboard.razorpay.com/app/keys
# Backend key/secret used to create and verify orders.
RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me

# Frontend Razorpay key (VITE_-prefixed so it is exposed to the browser bundle).
# Must match the RAZORPAY_KEY_ID above — it opens the Razorpay checkout modal.
# If left as the placeholder, the checkout is disabled and shows a clear error
# instead of silently using a fake test key.
VITE_RAZORPAY_KEY_ID=replace-me

# ═════════════════════════════════════════════
#  AWS S3 - File Uploads (optional)
# ═════════════════════════════════════════════

AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=ap-south-1
S3_BUCKET=replace-me


