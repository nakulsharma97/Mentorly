SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=replace-with-a-base64-encoded-32-byte-or-longer-secret
SENTRY_DSN=replace-with-your-backend-sentry-dsn
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
OAUTH2_REDIRECT_URL=http://localhost:5174/oauth/callback
APP_RATE_LIMIT_AUTH_PER_MINUTE=20
APP_RATE_LIMIT_PAYMENT_PER_MINUTE=30
POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/your-key
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/skill?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=12345
STRIPE_SECRET_KEY=replace-me
RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=ap-south-1
S3_BUCKET=replace-me
VITE_SENTRY_DSN=replace-with-your-frontend-sentry-dsn

CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

## Single Admin User
# Only this user can log in as ADMIN. Set both email and password to auto-seed on startup.
# Signups with role=ADMIN are rejected — this is the only way to create an admin.
APP_ADMIN_EMAIL=admin@skillswap.app
APP_ADMIN_PASSWORD=Admin@12345
APP_ADMIN_NAME=Platform Admin
