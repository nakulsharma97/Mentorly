# ── Mentorly frontend image for Render ───────────────────────────────────────
# Differences from ./Dockerfile (docker-compose / VPS image):
#   * listens on plain HTTP on $PORT (Render terminates TLS itself) instead of
#     nginx TLS on 443 with a mounted certificate;
#   * reverse-proxies the API to the backend's PUBLIC https origin, because a
#     free Render web service cannot be reached over the private network;
#   * publishes the Vite build-time variables as ARGs (Render exposes service
#     environment variables to Docker builds as build args).

# ── Build stage ─────────────────────────────────────────────────────────────
FROM node:20-bookworm-slim AS build

WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# Build-time configuration (baked into the bundle — nothing secret here).
# VITE_API_BASE_URL stays EMPTY on purpose: the SPA then calls same-origin
# /api/v1/* and nginx proxies it to the backend.
ARG VITE_API_BASE_URL=""
ARG VITE_APP_ENV=production
ARG VITE_RAZORPAY_KEY_ID=""
ARG VITE_STRIPE_PUBLISHABLE_KEY=""
ARG VITE_SENTRY_DSN=""
ARG VITE_ENABLE_MONITORING=""
ARG VITE_MONITORING_ENDPOINT=""

ENV VITE_API_BASE_URL="$VITE_API_BASE_URL" \
    VITE_APP_ENV="$VITE_APP_ENV" \
    VITE_RAZORPAY_KEY_ID="$VITE_RAZORPAY_KEY_ID" \
    VITE_STRIPE_PUBLISHABLE_KEY="$VITE_STRIPE_PUBLISHABLE_KEY" \
    VITE_SENTRY_DSN="$VITE_SENTRY_DSN" \
    VITE_ENABLE_MONITORING="$VITE_ENABLE_MONITORING" \
    VITE_MONITORING_ENDPOINT="$VITE_MONITORING_ENDPOINT"

RUN npm run build

# ── Runtime stage ───────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

# Render overrides PORT; the nginx template is rendered from it at startup.
ENV PORT=10000
# Public https origin of the backend Render service (override in the dashboard).
ENV BACKEND_URL=https://mentorly-api.onrender.com

RUN rm -f /etc/nginx/conf.d/default.conf
COPY nginx.render.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 10000
